# ==============================================================================
# Ares: Environment Configuration
# ==============================================================================

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# PostgreSQL LangGraph Checkpointer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ares_checkpoints
POSTGRES_USER=ares
POSTGRES_PASSWORD=ares_password

# Sandbox Execution Limits
ARES_SANDBOX_IMAGE=ares-sandbox:latest
ARES_SANDBOX_TIMEOUT_SECONDS=30
ARES_SANDBOX_MEMORY_LIMIT=1g
ARES_SANDBOX_CPU_LIMIT=1.0

# General
DEBUG=false
